{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "vitest/globals"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
